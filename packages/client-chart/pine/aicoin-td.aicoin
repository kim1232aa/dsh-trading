// @version=2
oup = close > close[4] ? nz(oup[1]) + 1 : 0
odn = close < close[4] ? nz(odn[1]) - 1 : 0

up = oup > 0 ? oup : nan
dn = odn < 0 ? -odn : nan

plot(up, title = "UP")
plot(dn, title = "Down")
